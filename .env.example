# Final public origin. Example: https://your-project.vercel.app
# Do not include a trailing slash, path, query string, or fragment.
APP_URL=http://localhost:3000

# Public legal identity. Required before Live Meta OAuth can start.
LEGAL_ENTITY_NAME=
PRIVACY_CONTACT_EMAIL=

# Meta Developer App credentials. Keep server-side only.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v25.0

# 32-byte key encoded as 64 hexadecimal characters.
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Random secret used to sign the owner session.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# One-owner bootstrap gate. Required before opening Meta OAuth.
# Generate a separate value with: openssl rand -base64 32
OWNER_SETUP_SECRET=

# Vercel Marketplace Postgres/Neon connection string.
DATABASE_URL=

# Vercel sends this as a Bearer token to protected cron routes.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# Optional. Show safe local sample data when Meta is not connected.
DEMO_MODE=true
